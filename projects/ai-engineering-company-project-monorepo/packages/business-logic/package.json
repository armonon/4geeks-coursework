{
  "name": "@trackflow/business-logic",
  "version": "0.1.0",
  "private": true,
  "description": "TrackFlow domain business logic — freight quotes and service-tier rules. Authoritative implementation for every UI and service in the monorepo (MONO-1).",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test 'dist/tests/**/*.js'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3"
  }
}
