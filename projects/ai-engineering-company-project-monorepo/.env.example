# Copy to .env before the first `docker compose up --build`.
# Use a unique random value outside local development.
TOKEN_4GEEKS=replace_with_your_student_token
SECRET_KEY=local-development-only-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The browser reaches the published backend port through the host. Containers
# use the Compose service name `backend` for container-to-container traffic.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3001
TRACKFLOW_API_INTERNAL_URL=http://backend:8000

# SQLite makes the complete inventory flow work without a cloud account.
# Replace this with the private Supabase pooler URI when testing Supabase.
DATABASE_URL=sqlite:////workspace/services/api/data/inventory.db

# Optional: without a Resend key the API logs reset links locally.
RESEND_API_KEY=
EMAIL_FROM=TrackFlow <onboarding@resend.dev>
