# JWT signing secret — generate your own, never commit the real .env:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_a_long_random_hex_string

# How long an access token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Where TinyDB stores users, profiles, and suppliers.
